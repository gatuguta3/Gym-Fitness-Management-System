<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_gym_member_form" model="ir.ui.view">
        <field name="name">gym.member.form</field>
        <field name="model">gym.member</field>
        <field name="arch" type="xml">
            <form string="Gym Member">
                <header>

                     <field name="membership_state" widget="statusbar" nolabel="1" options="{'clickable': '0'}"
                        statusbar_visible="renewed,expired"/>


                    <field name="attendance_state" widget="statusbar" nolabel="1" options="{'clickable': '0'}"
                        statusbar_visible="inactive,active"/>


                    <button name="action_extend_membership" type="object" string="Extend Membership" 
                        class="oe_highlight" invisible="attendance_state == 'inactive'"/>

                    <button name="action_send_payment_remainder" type="object" string="Send Renewal Reminder" 
                        class="oe_highlight" invisible="attendance_state == 'inactive'"/>

                    <button name="action_renew_membership" type="object" string="Renew Membership" 
                        class="oe_highlight" invisible="membership_state == 'renewed'"/>

                    
                </header>
                <sheet>
                    <field name="profile_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        
                        <group>
                            <group>
                                <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Full Name"/>
                            </h1>

                            </group>
                            
                            
                        </group>
                        
                        </div>
                    <group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="membership_id"/>
                            <field name="join_date"/>
                        </group>
                        <group>
                            
                            <field name="last_renewal_date"/>
                            <field name="expiry_date" edit="1"/>                            
                            <field name="last_check_in"/>
                             <field name="total_paid"/>
                             <field name="amount_due" edit="0"/>
                        </group>
                    </group>
                    <group>
                        <group></group>
                        <group></group>
                    </group>
                    <notebook>

                        <page string="Payment History">
                            <field name="payment_ids">
                                <tree string="Payments" create="0" delete="0" edit="0">
                                    <field name="amount"/>
                                    <field name="payment_date"/>
                                    <field name="payment_method"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Attendence History">
                            
                        </page> 

                        <page string="Membership History">
                            
                        </page> 

                        
                    </notebook>

                                        
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gym_member_tree" model="ir.ui.view">
        <field name="name">gym.member.tree</field>
        <field name="model">gym.member</field>
        <field name="arch" type="xml">
            <tree string="Gym Members">
                <field name="name"/>
                <field name="phone"/>     
                <field name="membership_id" widget="badge"/>           
                <field name="last_renewal_date"/>
                <field name="expiry_date"/>    
                 <field name="amount_due"/>                  
                <field name="membership_state"
                        decoration-success="membership_state == 'renewed'" decoration-warning="membership_state in ('expired')" widget="badge"/>  
                
                <field name="last_check_in"/>
                      
                
                <field name="attendance_state"
                        decoration-success="attendance_state == 'active'" decoration-danger="attendance_state in ('inactive')" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_gym_member_kanban" model="ir.ui.view">
        <field name="name">gym.member.kanban</field>
        <field name="model">gym.member</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_example">
                <templates>
                    <t t-name="kanban-box">                        
                        <div class="o_kanban_record">
                            <div class="oe_kanban_content">

                                <div class="o_kanban_image">
                                    <t t-if="record.profile_image.raw_value">
                                        <field name="profile_image" widget="image" class="oe_avatar" width="70" height="70"/>
                                    </t>
                                    <t t-else="">
                                        <img src="/web/static/img/placeholder.png" class="oe_kanban_image" alt="No Image"/>
                                    </t>
                                </div>
                                <div class="o_kanban_details">
                                    <div class="o_kanban_details_wrapper">
                                <strong><field name="name"/></strong>
                                <div>Email: <field name="email"/></div>
                                <div>Join Date: <field name="join_date"/></div>
                                <div>Membership: <field name="membership_id"/></div>
                                <div>Last Check In: <field name="last_check_in"/></div>
                                </div></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_gym_member" model="ir.actions.act_window">
        <field name="name">Gym Members</field>
        <field name="res_model">gym.member</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>

  <menuitem id="menu_gym_members" name="Members" parent="menu_gym_root" action="action_gym_member"/> 

</odoo>
