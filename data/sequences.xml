<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_gym_session" model="ir.sequence">
            <field name="name">Gym Session</field>
            <field name="code">gym.session</field>
            <field name="prefix">SES/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

<record id="cron_update_activity_states" model="ir.cron">
    <field name="name">Update Gym Activity States</field>
    <field name="model_id" ref="model_gym_activity"/>
    <field name="state">code</field>
    <field name="code">model.update_activity_states()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field name="doall" eval="False"/>
    <field name="active" eval="True"/>
</record>
    </data>
</odoo>